# Nova production configuration template. Copy to .env and load explicitly with:
#   uvicorn nova.api.main:app --env-file .env
# For local smoke-testing only, set NOVA_ENV=development and omit API keys.

# --- Deployment mode -----------------------------------------------------
NOVA_ENV=production

# --- Authentication ------------------------------------------------------
# Use either NOVA_API_KEY (single default tenant) OR NOVA_TENANT_API_KEYS.
# API keys in production must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Shared API key can access only the `default` tenant.
NOVA_API_KEY=
# For multiple tenants, map each tenant to a unique key. Do not set NOVA_API_KEY too.
# Format: tenant-a:LONG_RANDOM_KEY_A,tenant-b:LONG_RANDOM_KEY_B
NOVA_TENANT_API_KEYS=

# --- Persistence ---------------------------------------------------------
# Local SQLite for the control plane and default tenant storage.
NOVA_DB_PATH=nova.db
NOVA_CONTROL_DB_PATH=nova_control.db
# Per-tenant PostgreSQL is configured through authenticated /storage endpoints.
# DATABASE_URL is intentionally unsupported to avoid ambiguous storage ownership.

# --- Encryption ----------------------------------------------------------
# REQUIRED in production. Generate once and store in a secret manager; never rotate it
# without providing the old key in NOVA_ENCRYPTION_KEYS_PREVIOUS.
#   python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
NOVA_ENCRYPTION_KEY=
# Optional comma-separated previous keys during key rotation.
NOVA_ENCRYPTION_KEYS_PREVIOUS=

# --- Providers -----------------------------------------------------------
# Configure OpenAI-compatible provider credentials per tenant in the API/UI. Credentials
# are encrypted with NOVA_ENCRYPTION_KEY. FakeLLM is disabled by default and forbidden in prod.
NOVA_ALLOW_FAKE_LLM=false
# Enable only when providers/databases intentionally use private IPs. This relaxes SSRF checks.
NOVA_ALLOW_PRIVATE_ENDPOINTS=false

# --- Browser identity (optional; required only for a hosted browser UI) ---
# NOVA_IDENTITY_MODE=api_key keeps service-to-service API-key auth only and exposes no
# browser login. Set it to oidc to mount the same-origin BFF at /api/bff and require the
# settings below; production startup FAILS CLOSED when mode=oidc is incomplete.
NOVA_IDENTITY_MODE=api_key
# Standard OIDC provider settings (any conformant provider). Never commit real values.
NOVA_OIDC_ISSUER=
NOVA_OIDC_CLIENT_ID=
NOVA_OIDC_CLIENT_SECRET=
# Must share the NOVA_BFF_ORIGIN origin; e.g. https://app.example.com/api/bff/callback
NOVA_OIDC_REDIRECT_URI=
NOVA_OIDC_SCOPES=openid,email,profile
# The public origin of this application (scheme + host + optional port, no path).
NOVA_BFF_ORIGIN=
# Server-side identity -> workspace grants. Format: identity:tenant:role
# NOVA_IDENTITY_USERS=alice@example.com:tenant-a:admin,bob@example.com:tenant-b:viewer
NOVA_IDENTITY_USERS=
# Optional alternative: map an IdP group claim value to a workspace grant.
# NOVA_IDENTITY_GROUPS=team-a:tenant-a:editor
NOVA_IDENTITY_GROUPS=
# Session lifetimes and cookie posture. __Host- cookies require Secure, so keep this true
# everywhere except a local http development setup.
NOVA_SESSION_COOKIE_SECURE=true
NOVA_SESSION_ABSOLUTE_SECONDS=28800
NOVA_SESSION_IDLE_SECONDS=1800
# Login and mutation throttles (per process; also enforce limits at the edge).
NOVA_BFF_LOGIN_RATE_PER_MINUTE=10
NOVA_BFF_MUTATION_RATE_PER_MINUTE=60
NOVA_BFF_PROXY_TIMEOUT_SECONDS=60
# Identity tokens must be signed with one of these; "none" is never accepted.
NOVA_OIDC_ALLOWED_ALGS=RS256,ES256,PS256

# --- Limits and operations ----------------------------------------------
NOVA_MAX_BODY_BYTES=1048576
NOVA_AUDIT_RETENTION_DAYS=90
LOG_LEVEL=INFO
