# Keep source distributions usable for maintainers and regression testing.
include README.md
include CLAUDE.md
include AGENTS.md
include .env.example
include context_anchor_architecture.pdf
recursive-include docs *.md
recursive-include benchmark *.py
recursive-include scripts *.py
recursive-include tests *.py
recursive-include frontend *.css *.html *.js *.json *.ts *.tsx *.md
include frontend/.gitignore
prune frontend/node_modules
prune frontend/dist
prune frontend/coverage
prune frontend/playwright-report
prune frontend/test-results
prune frontend/.vite
# Workflow source is read by the benchmark regression tests in source archives.
include .github/workflows/benchmark.yml
include .github/workflows/ci.yml
